# ---- required --------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SNIPES_CHANNEL_ID=C0123456789
ZEKE_USER_ID=U0123456789

# ---- required for the Slack bot only (Socket Mode); the webapp doesn't need it
SLACK_APP_TOKEN=xapp-...

# ---- webapp ----------------------------------------------------------------
# HTTP Basic password for the admin UI (any username). REQUIRED if WEBAPP_HOST
# is anything other than a loopback address; the webapp refuses to start
# exposed without one (set WEBAPP_ALLOW_INSECURE=1 to override on a trusted LAN).
WEBAPP_PASSWORD=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8420

# ---- optional --------------------------------------------------------------
# Who gets review DMs (defaults to ZEKE_USER_ID).
REVIEWER_USER_ID=
# Run /test there instead of the live channel.
TEST_CHANNEL_ID=
# IANA timezone for dates, "time of day" and streaks (default: the server's).
TIMEZONE=America/New_York
SEASON_START_DATE=2026-08-15
SNIPESBOT_DATA_DIR=data

# Slack's free-tier retention, in days (drives the "archive is empty" warning
# and how far back deletion detection looks).
SLACK_MESSAGE_RETENTION_DAYS=90
CATCHUP_INTERVAL_SECONDS=21600
CONNECTIVITY_CHECK_INTERVAL_SECONDS=30
# Seconds to wait before DMing about an unidentified photo (or until enough
# later messages arrive).
CONTEXT_CAPTURE_DELAY_SECONDS=90
CONTEXT_WINDOW=2
NOTABLE_MIN_OTHER_STARS=3

# Comma-separated; matched as whole words, case-insensitively.
# SNIPE_KEYWORDS=snipe,sniped,snipes,sniping
# SNOPE_KEYWORDS=snope,snoped,snopes,snoping

# Delete archived photo/video files when the Slack message is deleted.
PURGE_FILES_ON_DELETE=1

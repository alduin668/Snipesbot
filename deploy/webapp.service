[Unit]
Description=SnipesBot admin webapp
After=network.target

[Service]
Type=simple
User=slackbot
WorkingDirectory=/opt/slackbot/snipesbot
# Put WEBAPP_PASSWORD (and WEBAPP_HOST if not loopback) in this file.
EnvironmentFile=/opt/slackbot/snipesbot/.env
ExecStart=/opt/slackbot/venv/bin/python /opt/slackbot/snipesbot/webapp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
